---
/**
 * Dr Jasmine Admin — bulk import Posts from one pasted/uploaded Markdown document.
 * Loads site Author, categories, tags, and existing slugs for the BulkImportForm island.
 */
import { getAuthorForSite, listCategories, listPosts } from "@seo/blog";
import { BulkImportForm } from "../../../components/admin/BulkImportForm";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { joinAdminPath, requireLocalsSupabase } from "../../../lib/admin-auth";
import { drJasmineSiteConfig } from "../../../site-config";

export const prerender = false;

const base = import.meta.env.BASE_URL;
const siteId = drJasmineSiteConfig.projectId;
const supabase = requireLocalsSupabase(Astro.locals.supabase);

const [author, categories, posts] = await Promise.all([
  getAuthorForSite(supabase, siteId),
  listCategories(supabase, siteId),
  listPosts(supabase, siteId),
]);

const existingSlugs = posts.map((post) => post.slug);

/** Distinct tags already used on posts (for the live writer/LLM template). */
const existingTags = Array.from(
  new Set(
    posts.flatMap((post) =>
      Array.isArray(post.tags)
        ? post.tags.filter(
            (tag): tag is string => typeof tag === "string" && tag.trim().length > 0,
          )
        : [],
    ),
  ),
).sort((left, right) => left.localeCompare(right));

const postsListHref = joinAdminPath(base, "admin/posts");
const postsBaseHref = joinAdminPath(base, "admin/posts");
---

<AdminLayout title="Dr Jasmine Admin — Bulk import posts" wide>
  <BulkImportForm
    client:load
    siteId={siteId}
    postsListHref={postsListHref}
    postsBaseHref={postsBaseHref}
    author={author}
    categories={categories}
    existingTags={existingTags}
    existingSlugs={existingSlugs}
  />
</AdminLayout>
