---
/**
 * Dr Jasmine Admin Author profile page.
 *
 * Edits the single site-scoped author row for Dr Jasmine and optionally uploads
 * an author photo into Supabase Storage under `media/dr-jasmine/blog/authors/`.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAuthorForSite, upsertAuthorForSite } from "@seo/blog";
import { requireLocalsSupabase } from "../../lib/admin-auth";
import {
  DR_JASMINE_BLOG_AUTHORS_PREFIX,
  MAX_BLOG_COVER_BYTES,
  MEDIA_BUCKET_ID,
  sanitizeStorageFilename,
} from "../../lib/storage";
import { drJasmineSiteConfig } from "../../site-config";

export const prerender = false;

type AuthorFormValues = {
  name: string;
  bio: string;
  photoUrl: string;
};

type AuthorPageState = {
  values: AuthorFormValues;
  successMessage: string | null;
  errorMessage: string | null;
};

const SITE_ID = drJasmineSiteConfig.projectId;

/**
 * Reads a required string field from FormData.
 *
 * @param formData - Request form payload.
 * @param key - Field name.
 * @returns Trimmed string value.
 */
function readRequiredString(formData: FormData, key: string): string {
  const value = formData.get(key);
  if (typeof value !== "string") {
    throw new Error(`Missing required field: ${key}`);
  }
  const trimmedValue = value.trim();
  if (trimmedValue.length === 0) {
    throw new Error(`Field "${key}" cannot be empty.`);
  }
  return trimmedValue;
}

/**
 * Reads an optional string field from FormData.
 *
 * @param formData - Request form payload.
 * @param key - Field name.
 * @returns Trimmed value or empty string.
 */
function readOptionalString(formData: FormData, key: string): string {
  const value = formData.get(key);
  if (typeof value !== "string") {
    return "";
  }
  return value.trim();
}

/**
 * Validates and narrows a file input to an image file.
 *
 * @param entry - Candidate form data entry.
 * @returns Image File or `null` when no file was submitted.
 */
function readImageFile(entry: FormDataEntryValue | null): File | null {
  if (entry === null || typeof entry === "string") {
    return null;
  }
  if (entry.size === 0) {
    return null;
  }
  if (!entry.type.startsWith("image/")) {
    throw new Error("Author photo must be an image file.");
  }
  if (entry.size > MAX_BLOG_COVER_BYTES) {
    throw new Error("Author photo must be 5 MB or smaller.");
  }
  return entry;
}

/**
 * Uploads an author photo to Supabase Storage and returns its public URL.
 *
 * @param supabase - Request-scoped server Supabase client.
 * @param imageFile - Validated image file.
 * @returns Public URL for the uploaded file.
 */
async function uploadAuthorPhoto(
  supabase: ReturnType<typeof requireLocalsSupabase>,
  imageFile: File,
): Promise<string> {
  const timestamp = Date.now().toString();
  const sanitizedName = sanitizeStorageFilename(imageFile.name);
  const storagePath = [
    DR_JASMINE_BLOG_AUTHORS_PREFIX,
    `${timestamp}-${sanitizedName}`,
  ].join("/");

  const uploadResult = await supabase.storage
    .from(MEDIA_BUCKET_ID)
    .upload(storagePath, imageFile, {
      upsert: false,
      contentType: imageFile.type,
      cacheControl: "3600",
    });

  if (uploadResult.error !== null) {
    throw new Error(`Photo upload failed: ${uploadResult.error.message}`);
  }

  const publicResult = supabase.storage.from(MEDIA_BUCKET_ID).getPublicUrl(storagePath);
  const publicUrl = publicResult.data.publicUrl;
  if (typeof publicUrl !== "string" || publicUrl.trim().length === 0) {
    throw new Error("Photo upload succeeded but no public URL was returned.");
  }

  return publicUrl.trim();
}

/**
 * Converts unknown errors to a safe user-facing message.
 *
 * @param error - Unknown caught error value.
 * @returns User-facing message.
 */
function toErrorMessage(error: unknown): string {
  if (error instanceof Error && error.message.trim().length > 0) {
    return error.message;
  }
  return "Could not save author changes. Please try again.";
}

const supabase = requireLocalsSupabase(Astro.locals.supabase);
const existingAuthor = await getAuthorForSite(supabase, SITE_ID);

let state: AuthorPageState = {
  values: {
    name: existingAuthor?.name ?? "",
    bio: existingAuthor?.bio ?? "",
    photoUrl: existingAuthor?.photoUrl ?? "",
  },
  successMessage: null,
  errorMessage: null,
};

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const submittedName = readOptionalString(formData, "name");
  const submittedBio = readOptionalString(formData, "bio");
  const submittedPhotoUrl = readOptionalString(formData, "photo_url");

  try {
    const name = readRequiredString(formData, "name");
    const bio = readOptionalString(formData, "bio");
    const photoUrlInput = readOptionalString(formData, "photo_url");
    const imageFile = readImageFile(formData.get("photo_file"));

    let photoUrlToSave: string | null = photoUrlInput.length > 0 ? photoUrlInput : null;
    if (imageFile !== null) {
      photoUrlToSave = await uploadAuthorPhoto(supabase, imageFile);
    }

    const savedAuthor = await upsertAuthorForSite(supabase, SITE_ID, {
      name,
      bio,
      photoUrl: photoUrlToSave,
    });

    state = {
      values: {
        name: savedAuthor.name,
        bio: savedAuthor.bio,
        photoUrl: savedAuthor.photoUrl ?? "",
      },
      successMessage:
        imageFile !== null
          ? "Author saved and photo uploaded."
          : "Author profile saved.",
      errorMessage: null,
    };
  } catch (error) {
    state = {
      values: {
        name: submittedName,
        bio: submittedBio,
        photoUrl: submittedPhotoUrl,
      },
      successMessage: null,
      errorMessage: toErrorMessage(error),
    };
  }
}

const hasPhoto = state.values.photoUrl.length > 0;
---

<AdminLayout title="Dr Jasmine Admin Author">
  <section class="admin-page">
    <header>
      <h1 class="admin-page__title">Author Profile</h1>
      <p class="admin-page__lede">
        This is the single Dr Jasmine site author used as the post byline. Uploading a
        photo takes priority over the URL field.
      </p>
    </header>

    {state.errorMessage !== null ? (
      <p class="admin-message admin-message--error" role="alert">{state.errorMessage}</p>
    ) : null}

    {state.successMessage !== null ? (
      <p class="admin-message admin-message--success" role="status">{state.successMessage}</p>
    ) : null}

    <form method="POST" enctype="multipart/form-data" class="admin-card">
      <label class="admin-field">
        <span class="admin-field__label">Name</span>
        <input
          class="admin-input"
          name="name"
          type="text"
          required
          value={state.values.name}
        />
      </label>

      <label class="admin-field">
        <span class="admin-field__label">Bio</span>
        <textarea class="admin-textarea" name="bio" rows={6}>{state.values.bio}</textarea>
      </label>

      <div class="admin-field">
        <span class="admin-field__label">Photo preview</span>
        <img
          id="author-photo-preview"
          class="admin-image-preview"
          src={hasPhoto ? state.values.photoUrl : ""}
          alt={hasPhoto ? "Author photo preview" : ""}
          hidden={!hasPhoto}
          data-fallback-src={state.values.photoUrl}
        />
        {!hasPhoto ? (
          <p id="author-photo-empty" class="admin-field__hint">
            No photo yet. Paste a URL or upload an image below.
          </p>
        ) : null}
      </div>

      <label class="admin-field">
        <span class="admin-field__label">Photo URL (fallback)</span>
        <input
          id="author-photo-url"
          class="admin-input"
          name="photo_url"
          type="url"
          inputmode="url"
          placeholder="https://example.com/photo.jpg"
          value={state.values.photoUrl}
        />
        <span class="admin-field__hint">
          Used when you do not upload a file. Upload overrides this URL on save.
        </span>
      </label>

      <label class="admin-field">
        <span class="admin-field__label">Upload photo (optional, max 5 MB)</span>
        <input
          id="author-photo-file"
          class="admin-input"
          name="photo_file"
          type="file"
          accept="image/*"
        />
        <span class="admin-field__hint">
          Choosing a file previews it here and replaces the URL when you save.
        </span>
      </label>

      <div class="admin-actions">
        <button class="admin-btn admin-btn--primary" type="submit">Save Author</button>
      </div>
    </form>
  </section>

  <script>
    /**
     * Wires live author photo preview from URL paste or file selection.
     */
    function initAuthorPhotoPreview(): void {
      const preview = document.getElementById("author-photo-preview");
      const urlInput = document.getElementById("author-photo-url");
      const fileInput = document.getElementById("author-photo-file");
      const emptyHint = document.getElementById("author-photo-empty");

      if (
        !(preview instanceof HTMLImageElement) ||
        !(urlInput instanceof HTMLInputElement) ||
        !(fileInput instanceof HTMLInputElement)
      ) {
        return;
      }

      let objectUrl: string | null = null;

      /**
       * Shows or hides the preview image for a given source URL.
       *
       * @param src - Image URL, or empty to hide.
       */
      function showPreview(src: string): void {
        if (!(preview instanceof HTMLImageElement)) {
          return;
        }
        if (src.trim().length === 0) {
          preview.hidden = true;
          preview.removeAttribute("src");
          preview.alt = "";
          if (emptyHint !== null) {
            emptyHint.hidden = false;
          }
          return;
        }
        preview.hidden = false;
        preview.src = src;
        preview.alt = "Author photo preview";
        if (emptyHint !== null) {
          emptyHint.hidden = true;
        }
      }

      /**
       * Revokes a prior object URL created for a local file preview.
       */
      function clearObjectUrl(): void {
        if (objectUrl !== null) {
          URL.revokeObjectURL(objectUrl);
          objectUrl = null;
        }
      }

      urlInput.addEventListener("input", () => {
        clearObjectUrl();
        fileInput.value = "";
        showPreview(urlInput.value.trim());
      });

      fileInput.addEventListener("change", () => {
        clearObjectUrl();
        const files = fileInput.files;
        const file = files !== null && files.length > 0 ? files.item(0) : null;
        if (file === null) {
          const fallback = preview.dataset.fallbackSrc ?? urlInput.value.trim();
          showPreview(fallback);
          return;
        }
        objectUrl = URL.createObjectURL(file);
        showPreview(objectUrl);
      });
    }

    initAuthorPhotoPreview();
  </script>
</AdminLayout>
