---
/**
 * @fileoverview Native home composed from GHL registration LDP content,
 * plus Health Insights and Featured Reels teasers.
 */
import { listPublishedPostsPage } from "@seo/blog";
import portraitImage from "@/assets/ghl/dr-jasmine-portrait.jpg";
import { requireBlogSupabase } from "@/components/blog/blog-format";
import HomeBlog from "@/components/home/HomeBlog.astro";
import HomeDiscover from "@/components/home/HomeDiscover.astro";
import HomeFaqTeaser from "@/components/home/HomeFaqTeaser.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeMeetDoctor from "@/components/home/HomeMeetDoctor.astro";
import HomeProof from "@/components/home/HomeProof.astro";
import HomeReels from "@/components/home/HomeReels.astro";
import HomeWorkshopBand from "@/components/home/HomeWorkshopBand.astro";
import "@/components/home/home.css";
import {
  credentials,
  faqs,
  homeCopy,
  testimonials,
  workshopCopy,
} from "@/data/site";
import { buildWebSiteJsonLd } from "@/data/seo/jsonld-pages";
import { defaultPublicOgImageUrl } from "@/data/seo/og-defaults";
import { listPublishedReels } from "@/lib/instagram-reels";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { drJasmineSiteConfig } from "@/site-config";

export const prerender = false;

/** Newest posts to surface on the homepage blog teaser. */
const HOME_BLOG_LIMIT = 3;

/** Featured Instagram Reels to surface on the homepage. */
const HOME_REELS_LIMIT = 3;

/** GHL document title from the registration LDP capture. */
const title = "Reverse Diabetes Workshop";
/** Meta description built from GHL hero subcopy only. */
const description = homeCopy.subhead;

const jsonLd = buildWebSiteJsonLd({
  pathname: Astro.url.pathname,
  description,
  faqs,
});
const ogImage = defaultPublicOgImageUrl();

const supabase = requireBlogSupabase(Astro.locals.supabase);
const siteId = drJasmineSiteConfig.projectId;

const [{ posts: latestPosts }, homeReels] = await Promise.all([
  listPublishedPostsPage(supabase, siteId, {
    limit: HOME_BLOG_LIMIT,
    offset: 0,
  }),
  listPublishedReels(supabase, siteId, { limit: HOME_REELS_LIMIT }),
]);
---

<PublicLayout title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <HomeHero copy={homeCopy} portrait={portraitImage} />
  <HomeDiscover copy={workshopCopy} />
  <HomeMeetDoctor credentials={credentials} portrait={portraitImage} />
  <HomeProof testimonials={testimonials} />
  {homeReels.length > 0 ? <HomeReels reels={homeReels} /> : null}
  {latestPosts.length > 0 ? <HomeBlog posts={latestPosts} /> : null}
  <HomeWorkshopBand copy={workshopCopy} />
  <HomeFaqTeaser items={faqs} />
</PublicLayout>
