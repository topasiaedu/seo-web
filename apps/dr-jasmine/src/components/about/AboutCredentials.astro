---
/**
 * @fileoverview About credentials: featured education + numbered trust signals.
 */
import type { AboutCopy, CredentialItem } from "@/data/site";

interface Props {
  /** About credentials headings and education line. */
  copy: AboutCopy;
  /** Exact GHL Meet Dr Jasmine credential bullets. */
  credentials: readonly CredentialItem[];
}

const { copy, credentials } = Astro.props;

/** GHL trust bullets only; education is featured separately above the grid. */
const trustSignals: readonly CredentialItem[] = credentials;
---

<section
  class="dj-home-section dj-about-credentials"
  aria-labelledby="dj-about-credentials-heading"
>
  <div class="dj-public-container dj-about-credentials__inner">
    <header class="dj-about-credentials__header">
      <h2 class="dj-home-heading" id="dj-about-credentials-heading">
        {copy.credentialsHeading}
      </h2>
    </header>

    <p class="dj-about-credentials__education">
      <span class="dj-about-credentials__education-eyebrow">Education</span>
      <span class="dj-about-credentials__education-label">{copy.educationLabel}</span>
    </p>

    <ul class="dj-about-credentials__grid">
      {
        trustSignals.map((item) => (
          <li class="dj-about-credentials__signal">
            <p class="dj-about-credentials__label">{item.label}</p>
          </li>
        ))
      }
    </ul>

    <ul class="dj-about-credentials__facts" aria-label="Additional trust signals">
      {
        copy.secondaryFactItems.map((fact) => (
          <li class="dj-about-credentials__fact">{fact}</li>
        ))
      }
    </ul>
  </div>
</section>
