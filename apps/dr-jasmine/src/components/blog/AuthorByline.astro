---
/**
 * Author byline (name, bio, optional photo) with optional publish meta
 * and brand Instagram / LinkedIn links from site config.
 */
import type { Author } from "@seo/blog";
import { drJasmineSiteConfig } from "@/site-config";

interface Props {
  author: Author;
  /** Formatted publish date label (e.g. "23 Jul 2026"). */
  dateLabel?: string;
  /** ISO datetime for the `<time>` element when `dateLabel` is set. */
  publishedAt?: string | null;
  /** Formatted reading-time label (e.g. "12 min read"). */
  readingLabel?: string;
  /**
   * When false, hides the author bio (useful in the article lead when the
   * full AuthorCard appears below the story).
   */
  showBio?: boolean;
  /**
   * When false, hides Instagram / LinkedIn links (default true).
   */
  showSocial?: boolean;
}

const {
  author,
  dateLabel = "",
  publishedAt = null,
  readingLabel = "",
  showBio = true,
  showSocial = true,
} = Astro.props;
const hasPhoto =
  typeof author.photoUrl === "string" && author.photoUrl.trim().length > 0;
const bio =
  typeof author.bio === "string" && author.bio.trim().length > 0
    ? author.bio.trim()
    : "";
const hasDate =
  typeof dateLabel === "string" && dateLabel.trim().length > 0;
const hasReading =
  typeof readingLabel === "string" && readingLabel.trim().length > 0;
const datetimeAttr =
  typeof publishedAt === "string" && publishedAt.trim().length > 0
    ? publishedAt.trim()
    : undefined;

const instagramUrl = drJasmineSiteConfig.social.instagram.trim();
const linkedinUrl = drJasmineSiteConfig.social.linkedin.trim();
const hasSocial =
  showSocial && (instagramUrl.length > 0 || linkedinUrl.length > 0);
---

<div class="blog-byline">
  {
    hasPhoto ? (
      <div class="blog-byline__photo">
        <img
          src={author.photoUrl ?? ""}
          alt=""
          width="56"
          height="56"
          loading="lazy"
        />
      </div>
    ) : null
  }
  <div class="blog-byline__text">
    <p class="blog-byline__name">{author.name}</p>
    {
      hasDate || hasReading ? (
        <p class="blog-byline__meta">
          {
            hasDate ? (
              <time datetime={datetimeAttr}>{dateLabel.trim()}</time>
            ) : null
          }
          {
            hasReading ? (
              <span class:list={[hasDate ? "blog-byline__meta-sep" : null]}>
                {readingLabel.trim()}
              </span>
            ) : null
          }
        </p>
      ) : null
    }
    {
      showBio && bio.length > 0 ? (
        <p class="blog-byline__bio">{bio}</p>
      ) : null
    }
    {
      hasSocial ? (
        <ul class="blog-byline__socials" aria-label="Author on social media">
          {
            instagramUrl.length > 0 ? (
              <li>
                <a
                  class="blog-byline__social"
                  href={instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Instagram
                </a>
              </li>
            ) : null
          }
          {
            linkedinUrl.length > 0 ? (
              <li>
                <a
                  class="blog-byline__social"
                  href={linkedinUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  LinkedIn
                </a>
              </li>
            ) : null
          }
        </ul>
      ) : null
    }
  </div>
</div>
