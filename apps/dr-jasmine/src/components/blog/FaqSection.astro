---
/**
 * FAQ section for a published Post — accordion via `<details>`.
 */
import type { FaqItem } from "@seo/blog";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
const faqs = Array.isArray(items)
  ? items.filter(
      (item) =>
        typeof item.question === "string" &&
        item.question.trim().length > 0 &&
        typeof item.answer === "string" &&
        item.answer.trim().length > 0,
    )
  : [];
---

{
  faqs.length > 0 ? (
    <section
      class="blog-section blog-section--faq"
      aria-labelledby="blog-faq-heading"
    >
      <p class="blog-section__eyebrow">Common questions</p>
      <h2 id="blog-faq-heading" class="blog-section__title">
        Frequently asked questions
      </h2>
      <div class="blog-faq">
        {faqs.map((item) => (
          <details class="blog-faq__item">
            <summary>
              <span class="blog-faq__question">{item.question.trim()}</span>
              <svg
                class="blog-faq__chevron"
                viewBox="0 0 20 20"
                width="20"
                height="20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                  clip-rule="evenodd"
                />
              </svg>
            </summary>
            <p class="blog-faq__a">{item.answer.trim()}</p>
          </details>
        ))}
      </div>
    </section>
  ) : null
}
