---
/**
 * End-of-article author card — name, photo, bio, and brand social links.
 */
import type { Author } from "@seo/blog";
import { drJasmineSiteConfig } from "@/site-config";

interface Props {
  /** Post author when set; falls back to site brand name. */
  author: Author | null;
}

const { author } = Astro.props;

const name =
  author !== null &&
  typeof author.name === "string" &&
  author.name.trim().length > 0
    ? author.name.trim()
    : drJasmineSiteConfig.name;

const photoUrl =
  author !== null &&
  typeof author.photoUrl === "string" &&
  author.photoUrl.trim().length > 0
    ? author.photoUrl.trim()
    : "";

const bio =
  author !== null &&
  typeof author.bio === "string" &&
  author.bio.trim().length > 0
    ? author.bio.trim()
    : "";

const instagramUrl = drJasmineSiteConfig.social.instagram.trim();
const linkedinUrl = drJasmineSiteConfig.social.linkedin.trim();
const hasSocial = instagramUrl.length > 0 || linkedinUrl.length > 0;
---

<section class="blog-author-card" aria-labelledby="blog-author-heading">
  <div class="blog-author-card__inner">
    {
      photoUrl.length > 0 ? (
        <div class="blog-author-card__photo">
          <img
            src={photoUrl}
            alt=""
            width="96"
            height="96"
            loading="lazy"
          />
        </div>
      ) : (
        <div
          class="blog-author-card__photo blog-author-card__photo--empty"
          aria-hidden="true"
        >
          <span>{name.slice(0, 1)}</span>
        </div>
      )
    }
    <div class="blog-author-card__body">
      <p class="blog-author-card__eyebrow" id="blog-author-heading">
        Written by
      </p>
      <p class="blog-author-card__name">{name}</p>
      {bio.length > 0 ? <p class="blog-author-card__bio">{bio}</p> : null}
      {
        hasSocial ? (
          <ul class="blog-author-card__socials" aria-label="Author on social media">
            {
              instagramUrl.length > 0 ? (
                <li>
                  <a
                    class="blog-author-card__social"
                    href={instagramUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Instagram
                  </a>
                </li>
              ) : null
            }
            {
              linkedinUrl.length > 0 ? (
                <li>
                  <a
                    class="blog-author-card__social"
                    href={linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    LinkedIn
                  </a>
                </li>
              ) : null
            }
          </ul>
        ) : null
      }
    </div>
  </div>
</section>
