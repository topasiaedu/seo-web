---
/**
 * @fileoverview Meet Dr. Jasmine band from GHL `main-body.html` (exact bullets),
 * plus Instagram / LinkedIn links from site config and a link to the full About page.
 */
import type { ImageMetadata } from "astro";
import type { CredentialItem } from "@/data/site";
import { aboutCopy } from "@/data/site";
import { landingImageAlts } from "@/data/landing/images";
import { joinPublicPath } from "@/scripts/site-nav";
import { drJasmineSiteConfig } from "@/site-config";

interface Props {
  /** Exact GHL credential bullets. */
  credentials: readonly CredentialItem[];
  /** Doctor portrait from GHL CDN asset. */
  portrait: ImageMetadata;
}

const { credentials, portrait } = Astro.props;
const portraitAlt = landingImageAlts.drJasminePortrait;
const { instagram, linkedin } = drJasmineSiteConfig.social;
const aboutHref = joinPublicPath(import.meta.env.BASE_URL, "about");
---

<section
  id="dj-home-meet"
  class="dj-home-section dj-home-section--soft dj-home-meet"
  aria-labelledby="dj-home-meet-heading"
>
  <div class="dj-public-container dj-home-meet__grid">
    <figure class="dj-home-meet__portrait">
      <img
        src={portrait.src}
        width={portrait.width}
        height={portrait.height}
        alt={portraitAlt}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div>
      <h2 class="dj-home-heading" id="dj-home-meet-heading">Meet Dr. Jasmine</h2>
      <ul class="dj-home-meet__credentials">
        {
          credentials.map((item) => (
            <li class="dj-home-meet__credential">
              <p class="dj-home-meet__credential-label">{item.label}</p>
            </li>
          ))
        }
      </ul>

      <a class="dj-home-text-link" href={aboutHref}>
        {aboutCopy.readFullStoryLabel}
        <span aria-hidden="true">→</span>
      </a>

      <div class="dj-home-meet__socials" aria-label="Follow Dr. Jasmine">
        <a
          class="dj-home-meet__social"
          href={instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="dj-home-meet__social-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill="currentColor"
              d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2Zm0 7.9A3.1 3.1 0 1 1 12 8.9a3.1 3.1 0 0 1 0 6.2Zm6.1-8.1a1.12 1.12 0 1 1-2.24 0 1.12 1.12 0 0 1 2.24 0ZM12 2.5c-2.45 0-2.76.01-3.72.05-2.4.11-3.52 1.24-3.63 3.63-.04.96-.05 1.27-.05 3.72s.01 2.76.05 3.72c.11 2.39 1.23 3.52 3.63 3.63.96.04 1.27.05 3.72.05s2.76-.01 3.72-.05c2.4-.11 3.52-1.24 3.63-3.63.04-.96.05-1.27.05-3.72s-.01-2.76-.05-3.72c-.11-2.39-1.23-3.52-3.63-3.63C14.76 2.51 14.45 2.5 12 2.5Zm0 1.7c2.4 0 2.69.01 3.64.05 1.79.08 2.62.92 2.7 2.7.04.95.05 1.24.05 3.64s-.01 2.69-.05 3.64c-.08 1.78-.91 2.62-2.7 2.7-.95.04-1.24.05-3.64.05s-2.69-.01-3.64-.05c-1.79-.08-2.62-.92-2.7-2.7-.04-.95-.05-1.24-.05-3.64s.01-2.69.05-3.64c.08-1.78.91-2.62 2.7-2.7.95-.04 1.24-.05 3.64-.05Z"
            />
          </svg>
          <span>Instagram</span>
        </a>
        <a
          class="dj-home-meet__social"
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="dj-home-meet__social-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill="currentColor"
              d="M19.75 3H4.25A1.25 1.25 0 0 0 3 4.25v15.5A1.25 1.25 0 0 0 4.25 21h15.5A1.25 1.25 0 0 0 21 19.75V4.25A1.25 1.25 0 0 0 19.75 3ZM8.34 18.34H5.67V9.75h2.67v8.59ZM7 8.57a1.55 1.55 0 1 1 0-3.1 1.55 1.55 0 0 1 0 3.1Zm11.34 9.77h-2.67v-4.18c0-1-.02-2.28-1.39-2.28-1.39 0-1.6 1.09-1.6 2.21v4.25H10v-8.59h2.56v1.17h.04c.36-.68 1.23-1.39 2.53-1.39 2.7 0 3.2 1.78 3.2 4.09v4.72Z"
            />
          </svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>
