---
/**
 * @fileoverview Home proof band from GHL `testimonials.html`.
 * Infinite marquee of all testimonials with even fixed-height cards.
 */
import type { Testimonial } from "@/data/site";

interface Props {
  /** Full GHL testimonial list. */
  testimonials: readonly Testimonial[];
}

const { testimonials } = Astro.props;

/** Original list length; second half of the track is a visual duplicate. */
const originalCount = testimonials.length;

/** Track items: original set + duplicate for seamless looping. */
const trackItems: readonly Testimonial[] = [...testimonials, ...testimonials];

/**
 * Builds a one- or two-letter avatar initial from a display name.
 *
 * @param name - Patient name from GHL
 * @returns Uppercase initial(s) for the avatar circle
 */
function avatarInitials(name: string): string {
  const parts = name
    .trim()
    .split(/\s+/)
    .filter((part) => part.length > 0);

  if (parts.length === 0) {
    return "?";
  }

  const first = parts[0];
  if (typeof first !== "string" || first.length === 0) {
    return "?";
  }

  if (parts.length === 1) {
    return first.slice(0, 1).toUpperCase();
  }

  const last = parts[parts.length - 1];
  if (typeof last !== "string" || last.length === 0) {
    return first.slice(0, 1).toUpperCase();
  }

  return `${first.slice(0, 1)}${last.slice(0, 1)}`.toUpperCase();
}
---

<section class="dj-home-section dj-home-proof" aria-labelledby="dj-home-proof-heading">
  <div class="dj-public-container">
    <h2 class="dj-home-heading" id="dj-home-proof-heading">What People Are Saying</h2>
  </div>

  <div
    class="dj-home-proof__marquee"
    role="region"
    aria-label="Patient testimonials"
  >
    <div class="dj-home-proof__track">
      {
        trackItems.map((entry, index) => {
          const isDuplicate = index >= originalCount;
          const initials = avatarInitials(entry.name);

          return (
            <blockquote
              class="dj-home-quote"
              aria-hidden={isDuplicate ? "true" : undefined}
            >
              <div class="dj-home-quote__top">
                <span class="dj-home-quote__mark" aria-hidden="true">
                  <svg
                    viewBox="0 0 32 24"
                    width="28"
                    height="21"
                    fill="currentColor"
                    focusable="false"
                  >
                    <path d="M0 24V13.2C0 5.9 3.7 1.5 11.1 0L12.6 3.4C8.5 4.8 6.4 7.4 6.4 11.2H12V24H0Zm18 0V13.2C18 5.9 21.7 1.5 29.1 0L30.6 3.4C26.5 4.8 24.4 7.4 24.4 11.2H30V24H18Z" />
                  </svg>
                </span>
                <span
                  class="dj-home-quote__stars"
                  aria-label={isDuplicate ? undefined : "5 out of 5 stars"}
                >
                  {Array.from({ length: 5 }).map(() => (
                    <svg
                      class="dj-home-quote__star"
                      viewBox="0 0 20 20"
                      width="14"
                      height="14"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="currentColor"
                        d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.1 5.06 16.7l.94-5.5-4-3.9 5.53-.8L10 1.5z"
                      />
                    </svg>
                  ))}
                </span>
              </div>
              <p class="dj-home-quote__text">{entry.quote}</p>
              <footer class="dj-home-quote__footer">
                <span class="dj-home-quote__avatar" aria-hidden="true">
                  {initials}
                </span>
                <div class="dj-home-quote__meta">
                  <cite class="dj-home-quote__name">{entry.name}</cite>
                  <span class="dj-home-quote__program">{entry.program}</span>
                </div>
              </footer>
            </blockquote>
          );
        })
      }
    </div>
  </div>
</section>
