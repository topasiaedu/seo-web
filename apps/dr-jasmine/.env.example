# Required for Admin auth session (middleware + SSR).
# Project root only — no /rest/v1/ or /auth/v1/ suffix (e.g. https://abcdefgh.supabase.co)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only key — not used by Admin cookie session clients.
SUPABASE_SERVICE_ROLE_KEY=
# Absolute origin for canonical / Open Graph / sitemap (no trailing slash).
PUBLIC_SITE_ORIGIN=https://doctorjasmine.com
# Standalone Node server (production / Render): bind host and port.
HOST=0.0.0.0
PORT=4323
