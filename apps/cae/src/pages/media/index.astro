---
/**
 * CAE Media & Press route — `/cae/media/`.
 * Native ZWDS chrome matching the homepage (SiteHeader + article grid + footer).
 */
import MediaLayout from "../../layouts/MediaLayout.astro";
import SiteHeader from "../../components/home/SiteHeader.astro";
import MediaArticles from "../../components/media/MediaArticles.astro";
import SiteFooter from "../../components/home/SiteFooter.astro";
import { mediaMeta, requireMetaString } from "../../data/home/meta.ts";

export const prerender = true;

const title = requireMetaString(mediaMeta.title, "Media & Press - Cae Goh");
const description = requireMetaString(
  mediaMeta.description,
  "Media & Press coverage featuring CAE Goh and the Predictable Destiny System.",
);
---

<MediaLayout title={title} description={description}>
  <main class="cae-home">
    <SiteHeader />
    <MediaArticles />
    <SiteFooter />
  </main>
</MediaLayout>
