---
/**
 * CAE Media & Press route — `/cae/media/` (GHL lift from caegoh.com/media).
 * Prerendered so marketing stays static while the app runs in server mode.
 */
import MediaLayout from "../../layouts/MediaLayout.astro";
import MediaNav from "../../components/ghl/media/MediaNav.astro";
import MediaArticles from "../../components/ghl/media/MediaArticles.astro";
import MediaFooter from "../../components/ghl/media/MediaFooter.astro";
import { mediaMeta, requireMetaString } from "../../data/home/meta.ts";

export const prerender = true;

const title = requireMetaString(mediaMeta.title, "Media & Press - Cae Goh");
const description = requireMetaString(
  mediaMeta.description,
  "Media & Press coverage featuring CAE Goh and the Predictable Destiny System.",
);
---

<MediaLayout title={title} description={description}>
  <MediaNav />
  <MediaArticles />
  <MediaFooter />
</MediaLayout>
