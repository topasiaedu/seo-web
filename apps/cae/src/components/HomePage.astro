---
/**
 * CAE homepage body — native ZWDS-themed sections (Purple Star Astrology).
 * Replaces the GHL capture stack with `components/home/*` so light/dark tokens
 * and decorative language apply consistently without photo-bg overrides.
 */
import type { BlogPost } from "@seo/blog";
import type { SocialFeature } from "@/lib/social-features";
import SiteHeader from "./home/SiteHeader.astro";
import Hero from "./home/Hero.astro";
import PressMarquee from "./home/PressMarquee.astro";
import HomeInsights from "./home/HomeInsights.astro";
import HomeFeaturedSocial from "./home/HomeFeaturedSocial.astro";
import Pillars from "./home/Pillars.astro";
import Platform from "./home/Platform.astro";
import Testimonials from "./home/Testimonials.astro";
import ConnectCta from "./home/ConnectCta.astro";
import SiteFooter from "./home/SiteFooter.astro";

interface Props {
  /** Newest published Posts for the Blog band (empty hides the section). */
  recentPosts?: readonly BlogPost[];
  /** Published social features for the homepage teaser (empty hides the section). */
  featuredSocial?: readonly SocialFeature[];
}

const { recentPosts = [], featuredSocial = [] } = Astro.props;

const displaySocial = featuredSocial.filter(
  (feature) => feature.platform !== "xiaohongshu",
);
---

<main class="cae-home">
  <SiteHeader />
  <Hero />
  <PressMarquee />
  <HomeInsights posts={recentPosts} />
  {displaySocial.length > 0 ? (
    <HomeFeaturedSocial features={displaySocial} />
  ) : null}
  <Pillars />
  <Platform />
  <Testimonials />
  <ConnectCta />
  <SiteFooter />
</main>
