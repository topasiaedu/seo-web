---
/**
 * CAE homepage body — GHL capture sections with Blog (HomeInsights) in place
 * of the former Offerings ("LIFE STARTS AT YOUR FULL POTENTIAL") band.
 * Native `components/home/*` remain in the tree but are mostly unwired;
 * HomeInsights is the exception (live published Posts after Press).
 */
import type { BlogPost } from "@seo/blog";
import LogoBar from "./ghl/LogoBar.astro";
import Nav from "./ghl/Nav.astro";
import Hero from "./ghl/Hero.astro";
import Press from "./ghl/Press.astro";
import HomeInsights from "./home/HomeInsights.astro";
import Pillars from "./ghl/Pillars.astro";
import Platform from "./ghl/Platform.astro";
import SocialProof from "./ghl/SocialProof.astro";
import TestimonialCarousel from "./ghl/TestimonialCarousel.astro";
import Connect from "./ghl/Connect.astro";
import Footer from "./ghl/Footer.astro";

interface Props {
  /** Newest published Posts for the Blog band (empty hides the section). */
  recentPosts?: readonly BlogPost[];
}

const { recentPosts = [] } = Astro.props;
---

<LogoBar />
<Nav />
<Hero />
<Press />
<HomeInsights posts={recentPosts} />
<Pillars />
<Platform />
<SocialProof />
<TestimonialCarousel />
<Connect />
<Footer />
