---
/**
 * Document chrome for public blog routes — GHL MediaNav/Footer (home family)
 * plus native `.blog-page` content. Keeps SeoHead / OG / JSON-LD control.
 */
import "@/styles/ghl/ghl-runtime.css";
import "@/styles/ghl/media-page.css";
import "@/styles/ghl/host-patch.css";
import "@/styles/tokens.css";
import "./blog-page.css";
import MediaNav from "@/components/ghl/media/MediaNav.astro";
import MediaFooter from "@/components/ghl/media/MediaFooter.astro";
import SeoHead from "@/components/seo/SeoHead.astro";
import { requireMetaString } from "@/data/home/meta";
import type { JsonLdNode } from "@/data/home/jsonld";
import { toAbsoluteUrl } from "@/lib/site-url";
import logoAsset from "../../assets/logo.png";

interface Props {
  title: string;
  description?: string;
  /** Open Graph type — use `article` on Post detail. */
  ogType?: string;
  /** Absolute or site-relative OG image; defaults to brand logo. */
  ogImage?: string;
  /** Optional JSON-LD graph for `SeoHead`. */
  jsonLd?: JsonLdNode;
}

/**
 * Returns a trimmed non-empty page title, falling back when invalid.
 *
 * @param value - Candidate title from the page.
 * @param fallback - Fallback when invalid.
 * @returns Trimmed non-empty string.
 */
function resolveTitle(value: unknown, fallback: string): string {
  if (typeof value !== "string" || value.trim().length === 0) {
    return fallback;
  }
  return value.trim();
}

/**
 * Returns a trimmed meta description, or a brand fallback when absent.
 *
 * @param value - Optional description prop.
 * @returns Trimmed non-empty description.
 */
function resolveDescription(value: unknown): string {
  if (typeof value === "string" && value.trim().length > 0) {
    return value.trim();
  }
  return "Insights on Purple Star Astrology, Zi Wei Dou Shu, and life strategy from Cae Goh.";
}

const { title, description, ogType = "website", ogImage, jsonLd } =
  Astro.props;
const pageTitle = resolveTitle(title, "Blog · CAE");
const metaDescription = resolveDescription(description);
const logoSrc =
  typeof logoAsset === "object" &&
  logoAsset !== null &&
  "src" in logoAsset &&
  typeof logoAsset.src === "string"
    ? logoAsset.src
    : typeof logoAsset === "string"
      ? logoAsset
      : "";
if (logoSrc.length === 0) {
  throw new Error("BlogLayout: failed to resolve logo asset src.");
}
const resolvedOgImage =
  typeof ogImage === "string" && ogImage.trim().length > 0
    ? ogImage.trim()
    : toAbsoluteUrl(logoSrc);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={pageTitle}
      description={requireMetaString(metaDescription, metaDescription)}
      ogType={ogType}
      siteName="Cae Goh"
      ogImage={resolvedOgImage}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Archivo+Black&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div
      id="preview-container"
      class="preview-container hl_page-preview--content"
    >
      <MediaNav />
      <slot />
      <MediaFooter />
    </div>
  </body>
</html>
