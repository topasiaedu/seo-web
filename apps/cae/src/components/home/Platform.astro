---
/**
 * Platform mastery — app mockup plus Daily / Weekly / Monthly rhythm.
 * Phone has no decorative frame; rhythm icons are inline SVGs.
 */
import { homePlatform } from "@/data/home/platform";
import {
  getHomeImage,
  isHomeImageKey,
  type HomeImageAsset,
  type HomeImageKey,
} from "@/data/home/images";
import "@/styles/home/platform.css";

/**
 * Returns a usable `src` string from an Astro/Vite image import.
 *
 * @param asset - Static import from {@link homeImages}
 * @returns URL string for an `<img src>`
 */
function assetSrc(asset: HomeImageAsset): string {
  if (typeof asset === "string") {
    return asset;
  }
  if (
    typeof asset === "object" &&
    asset !== null &&
    "src" in asset &&
    typeof asset.src === "string"
  ) {
    return asset.src;
  }
  throw new Error("Platform: unsupported home image asset shape.");
}

/**
 * Resolves a content `imageKey` to a concrete image URL.
 *
 * @param imageKey - Logical slot from content modules
 * @param fallback - Known {@link HomeImageKey} when the content key is missing
 * @returns Resolved image URL
 */
function resolveImageSrc(imageKey: string, fallback: HomeImageKey): string {
  if (isHomeImageKey(imageKey)) {
    return assetSrc(getHomeImage(imageKey));
  }
  return assetSrc(getHomeImage(fallback));
}

/** Rhythm icon kind used to pick the matching SVG. */
type RhythmIconKind = "daily" | "weekly" | "monthly";

/**
 * Narrows a rhythm item id to a known icon kind.
 *
 * @param id - Rhythm item id from content
 * @returns Icon kind, defaulting to daily when unknown
 */
function rhythmIconKind(id: string): RhythmIconKind {
  if (id === "weekly" || id === "monthly") {
    return id;
  }
  return "daily";
}

const appSrc = resolveImageSrc(homePlatform.appImageKey, "platformApp");

const rhythmItems = homePlatform.rhythm.map((item) => ({
  ...item,
  iconKind: rhythmIconKind(item.id),
}));
---

<section class="cae-platform" aria-labelledby="cae-platform-heading">
  <div class="cae-platform__inner">
    <header class="cae-platform__intro">
      <p class="cae-eyebrow">Mastery platform</p>
      <h2 class="cae-platform__headline" id="cae-platform-heading">
        {homePlatform.headline}
      </h2>
      <p class="cae-platform__lead">{homePlatform.lead}</p>
    </header>

    <div class="cae-platform__visual">
      <img
        class="cae-platform__app"
        src={appSrc}
        alt={homePlatform.appAlt}
        title={homePlatform.appTitle}
        loading="lazy"
        decoding="async"
      />
    </div>

    <ul class="cae-platform__rhythm">
      {
        rhythmItems.map((item) => (
          <li class="cae-platform__rhythm-item">
            <span
              class="cae-platform__icon-badge"
              title={item.iconTitle}
              aria-hidden="true"
            >
              {item.iconKind === "daily" ? (
                <svg
                  class="cae-platform__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 21s-6.6-4.35-9.15-8.1C1.2 10.65 1.65 7.2 4.35 5.7 6.3 4.6 8.55 5.1 12 8.1c3.45-3 5.7-3.5 7.65-2.4 2.7 1.5 3.15 4.95 1.5 7.2C18.6 16.65 12 21 12 21Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                </svg>
              ) : null}
              {item.iconKind === "weekly" ? (
                <svg
                  class="cae-platform__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <rect
                    x="3.5"
                    y="4.5"
                    width="17"
                    height="15"
                    rx="3"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                  <path
                    d="M7 14.5 10.2 11l2.4 2.4L17 9.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle cx="17.5" cy="7" r="2" fill="currentColor" />
                </svg>
              ) : null}
              {item.iconKind === "monthly" ? (
                <svg
                  class="cae-platform__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 3.4 13.9 9h5.9l-4.8 3.5 1.8 5.7L12 14.9 7.2 18.2l1.8-5.7L4.2 9h5.9L12 3.4Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                </svg>
              ) : null}
            </span>
            <span class="visually-hidden">{item.iconAlt}</span>
            <h3 class="cae-platform__rhythm-title">{item.title}</h3>
            <p class="cae-platform__rhythm-body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
