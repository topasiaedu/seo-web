---
/**
 * @fileoverview Pillars + Ancient Wisdom — native port of GHL `section-m2EB8Ft6xN2`.
 *
 * Structure:
 *   light overlapping bar (−80px) with Consultations / Academy / Speaking
 *   → Ancient Wisdom headline + lavender subhead → collage image
 */
import { homePillars } from "@/data/home/pillars";
import {
  getHomeImage,
  isHomeImageKey,
  type HomeImageAsset,
  type HomeImageKey,
} from "@/data/home/images";
import "@/styles/home/pillars.css";

/**
 * Returns a usable `src` string from an Astro/Vite image import.
 *
 * @param asset - Static import from {@link homeImages}
 * @returns URL string for an `<img src>` or CSS `url()`
 */
function assetSrc(asset: HomeImageAsset): string {
  if (typeof asset === "string") {
    return asset;
  }
  if (
    typeof asset === "object" &&
    asset !== null &&
    "src" in asset &&
    typeof asset.src === "string"
  ) {
    return asset.src;
  }
  throw new Error("Pillars: unsupported home image asset shape.");
}

/**
 * Resolves a content `imageKey` to a concrete image URL.
 *
 * @param imageKey - Logical slot from content modules
 * @param fallback - Known {@link HomeImageKey} when the content key is missing
 * @returns Resolved image URL
 */
function resolveImageSrc(imageKey: string, fallback: HomeImageKey): string {
  if (isHomeImageKey(imageKey)) {
    return assetSrc(getHomeImage(imageKey));
  }
  return assetSrc(getHomeImage(fallback));
}

const collageSrc = resolveImageSrc(
  homePillars.wisdom.collageImageKey,
  "pillarsCollage",
);
const sectionBgSrc = assetSrc(getHomeImage("pillarsBg"));
---

<section
  class="cae-pillars"
  aria-labelledby="cae-pillars-wisdom-heading"
  style={`--pillars-bg-image: url("${sectionBgSrc}");`}
>
  <div class="cae-pillars__bg" aria-hidden="true"></div>

  <div class="cae-pillars__inner">
    <!-- GHL: .row-wdyPZU4xMb — light bar overlapping offerings -->
    <ul class="cae-pillars__bar">
      {
        homePillars.items.map((item) => (
          <li class="cae-pillars__item">
            <h2 class="cae-pillars__title">{item.title}</h2>
            <p class="cae-pillars__body">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="cae-pillars__wisdom">
      <h2 class="cae-pillars__wisdom-headline" id="cae-pillars-wisdom-heading">
        {homePillars.wisdom.headline}
      </h2>
      <p class="cae-pillars__wisdom-subhead">{homePillars.wisdom.subhead}</p>
      <div class="cae-pillars__collage">
        <img
          class="cae-pillars__collage-img"
          src={collageSrc}
          alt={homePillars.wisdom.collageAlt}
          title={homePillars.wisdom.collageTitle}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
