---
/**
 * @fileoverview Xiaohongshu / RedNote featured display card (cover + title + link).
 */
interface Props {
  /** Note permalink. */
  permalink: string;
  /** Card title. */
  title: string;
  /** Cover image URL. */
  coverImageUrl: string;
}

const { permalink, title, coverImageUrl } = Astro.props;

if (typeof permalink !== "string" || permalink.trim().length === 0) {
  throw new Error("XiaohongshuCard requires a non-empty permalink.");
}
if (typeof title !== "string" || title.trim().length === 0) {
  throw new Error("XiaohongshuCard requires a non-empty title.");
}
if (typeof coverImageUrl !== "string" || coverImageUrl.trim().length === 0) {
  throw new Error("XiaohongshuCard requires a non-empty coverImageUrl.");
}

const href = permalink.trim();
const label = title.trim();
const cover = coverImageUrl.trim();
---

<a
  class="cae-xhs-card"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="cae-xhs-card__media">
    <img
      class="cae-xhs-card__image"
      src={cover}
      alt=""
      width="480"
      height="640"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="cae-xhs-card__body">
    <span class="cae-xhs-card__platform">Xiaohongshu</span>
    <span class="cae-xhs-card__title">{label}</span>
    <span class="cae-xhs-card__cta">View on Xiaohongshu</span>
  </span>
</a>

<style>
  .cae-xhs-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 0.85rem;
    border: 1px solid var(--cae-border);
    background: var(--cae-bg-elevated);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.25s ease,
      border-color 0.2s ease,
      box-shadow 0.25s ease;
  }

  .cae-xhs-card:hover,
  .cae-xhs-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--cae-gold);
    box-shadow: 0 14px 28px -16px color-mix(in srgb, var(--cae-gold) 45%, transparent);
    outline: none;
  }

  .cae-xhs-card__media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: color-mix(in srgb, var(--cae-bg-deep) 70%, transparent);
  }

  .cae-xhs-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cae-xhs-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.95rem 1rem 1.1rem;
  }

  .cae-xhs-card__platform {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cae-gold);
  }

  .cae-xhs-card__title {
    font-family: var(--cae-font-display), var(--cae-font-sans);
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--cae-text-bright);
  }

  .cae-xhs-card__cta {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cae-text-muted);
  }
</style>
