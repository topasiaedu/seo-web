---
/**
 * @fileoverview GHL nav (`section-CfDAEFyJd7`) + mobile menu toggle.
 */
import GhlFragment from "./GhlFragment.astro";
import PublicThemeToggle from "@/components/site/PublicThemeToggle.astro";
import fragment from "./fragments/nav.html?raw";
---

<GhlFragment fragment={fragment} />
<PublicThemeToggle />

<script>
  /**
   * Toggles the GHL desktop/mobile nav popup (`.hide-popup` / open state).
   */
  function initGhlNav(): void {
    const root = document.querySelector(".cnav-menu-v2-m9OQtGI6ro");
    if (!(root instanceof HTMLElement)) {
      return;
    }
    const desktopMenu = root.querySelector(".nav-menu-desktop");
    const openBtn = root.querySelector(".nav-menu-mobile");
    const closeBtn = root.querySelector(".x-icon .touch-target, .x-icon");
    if (!(desktopMenu instanceof HTMLElement)) {
      return;
    }

    const open = (): void => {
      desktopMenu.classList.remove("hide-popup");
      desktopMenu.classList.add("show-popup");
    };
    const close = (): void => {
      desktopMenu.classList.add("hide-popup");
      desktopMenu.classList.remove("show-popup");
    };

    if (openBtn instanceof HTMLElement) {
      openBtn.addEventListener("click", (event) => {
        event.preventDefault();
        open();
      });
      openBtn.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open();
        }
      });
    }
    if (closeBtn instanceof HTMLElement) {
      closeBtn.addEventListener("click", (event) => {
        event.preventDefault();
        close();
      });
    }
  }

  initGhlNav();
  document.addEventListener("astro:page-load", initGhlNav);
</script>
